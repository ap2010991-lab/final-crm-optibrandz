generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(ACCOUNT_MANAGER)
  avatar        String?
  phone         String?
  permissions   String[]       @default([])
  clientId      String?
  isActive      Boolean        @default(true)
  failedLoginCount Int         @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tasks         Task[]
  activities    Activity[]
  leads         Lead[]         @relation("AssignedLeads")
  notifications Notification[]
  contentTasksCreated   ContentTask[] @relation("ContentTaskAuthor")
  contentTasksCompleted ContentTask[] @relation("ContentTaskCompleter")
  notes         Note[]         @relation("NoteOwner")
  noteShares    NoteShare[]    @relation("NoteReader")

  @@index([role, isActive])
  @@index([clientId])
}

enum Role {
  OWNER
  ACCOUNT_MANAGER
  DESIGNER
  SEO_EXEC
  CLIENT
}

model Lead {
  id              String     @id @default(uuid())
  name            String
  phone           String
  email           String?
  businessName    String?
  city            String?
  source          LeadSource @default(WEBSITE)
  status          LeadStatus @default(NEW)
  serviceInterest String[]
  budget          String?
  notes           String?
  score           Int        @default(0)
  assignedTo      User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  assignedToId    String?
  followUpDate    DateTime?
  convertedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  activities      Activity[]
  client          Client?

  @@index([status, followUpDate])
  @@index([source])
  @@index([assignedToId])
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  GOOGLE_ADS
  META_ADS
  REFERRAL
  WALK_IN
  INSTAGRAM
  COLD_CALL
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  CONVERTED
  LOST
}

model Client {
  id            String            @id @default(uuid())
  businessName  String
  contactPerson String
  phone         String
  email         String?
  city          String?
  industry      String?
  logoUrl       String?
  websiteUrl    String?
  gstNumber     String?
  address       String?
  healthScore   Int               @default(100)
  // How many posts a month this client is owed. Nullable on purpose: existing clients
  // keep working with no target until one is set, and nothing is inferred on their behalf.
  monthlyContentTarget Int?
  status        ClientStatus      @default(ACTIVE)
  onboardedAt   DateTime          @default(now())
  renewalDate   DateTime?
  totalValue    Float             @default(0)
  advancePaid   Float             @default(0)
  leadId        String?           @unique
  lead          Lead?             @relation(fields: [leadId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  services      ServiceOrder[]
  invoices      Invoice[]
  campaigns     CampaignLog[]
  activities    Activity[]
  calendarItems ContentCalendar[]
  contentTasks  ContentTask[]
  reports       Report[]

  @@index([status])
  @@index([city])
  @@index([renewalDate])
}

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
  ONBOARDING
}

model ServiceOrder {
  id           String        @id @default(uuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceType  ServiceType
  packageName  String?
  monthlyValue Float
  startDate    DateTime
  endDate      DateTime?
  status       ServiceStatus @default(ACTIVE)
  deliverables Json
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        Task[]

  @@index([clientId, status])
  @@index([serviceType])
}

enum ServiceType {
  SEO
  SMO
  SMM
  GOOGLE_ADS
  META_ADS
  YOUTUBE
  GMB
  WEBSITE
  GRAPHIC_DESIGN
  INFLUENCER
  CONTENT
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Task {
  id             String        @id @default(uuid())
  title          String
  description    String?
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  assignedToId   String
  assignedTo     User          @relation(fields: [assignedToId], references: [id])
  status         TaskStatus    @default(PENDING)
  priority       Priority      @default(MEDIUM)
  dueDate        DateTime
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([assignedToId, status])
  @@index([dueDate])
  @@index([priority])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  DONE
  OVERDUE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ContentCalendar {
  id            String        @id @default(uuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  platform      Platform
  postType      PostType
  caption       String?
  designBrief   String?
  scheduledDate DateTime?
  status        ContentStatus @default(DRAFT)
  mediaUrl      String?
  approvedAt    DateTime?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId, month, year])
  @@index([scheduledDate, status])
  @@index([platform])
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TWITTER
  YOUTUBE
  GOOGLE_ADS
  META_ADS
  GMB
}

enum PostType {
  REEL
  CAROUSEL
  STATIC
  STORY
  BLOG
  ARTICLE
}

enum ContentStatus {
  DRAFT
  IN_DESIGN
  REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

// The plain checklist of reels and posts owed to one client, ticked off as each one is
// made and uploaded.
//
// ContentCalendar above is the dated publishing plan and carries a platform, a date, a
// creative and a four-stage approval pipeline. This is the working list kept beside it:
// a line of text, a kind, and a tick. Keeping them separate is deliberate — forcing a
// "shoot the Diwali reel" note through the calendar's pipeline is what stopped anyone
// using it as a to-do list in the first place.
model ContentTask {
  id          String          @id @default(uuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  type        ContentTaskType @default(POST)
  notes       String?
  dueDate     DateTime?
  isDone      Boolean         @default(false)
  completedAt DateTime?

  // The list is shared by the whole team, so it records who put a job on it and who
  // finished it. Both are optional: tasks created before this existed have no author,
  // and an open task has no completer. SetNull rather than Cascade so removing a
  // colleague never deletes the record of work they did.
  createdById   String?
  createdBy     User?         @relation("ContentTaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  completedById String?
  completedBy   User?         @relation("ContentTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([clientId, isDone])
  @@index([clientId, createdAt])
}

// Deliberately the words the team uses out loud, not ContentCalendar's PostType — nobody
// asks for "a STATIC", they ask for a post.
enum ContentTaskType {
  REEL
  POST
  STORY
  CAROUSEL
  VIDEO
  OTHER
}

model Invoice {
  id            String        @id @default(uuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique
  clientPhone   String?
  amount        Float
  gstAmount     Float         @default(0)
  totalAmount   Float
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  paidAt        DateTime?
  paidAmount    Float?
  notes         String?
  pdfUrl        String?
  lineItems     Json
  // Raised by the monthly retainer run rather than typed by hand. The run used to ask
  // "has this client had any invoice this month?", so a ₹500 one-off charge silently
  // cancelled their whole retainer for that month. It now asks only about retainers.
  isRetainer    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId, status])
  @@index([dueDate])
  @@index([isRetainer, createdAt])
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model CampaignLog {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  platform       Platform
  adSpend        Float?
  leadsGenerated Int?
  impressions    Int?
  clicks         Int?
  ctr            Float?
  cpl            Float?
  seoKeywords    Json?
  followerGrowth Int?
  reach          Int?
  engagement     Float?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId, month, year])
  @@index([platform])
}

model Activity {
  id        String       @id @default(uuid())
  type      ActivityType
  note      String
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@index([clientId])
  @@index([userId, createdAt])
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
  TASK_DONE
  INVOICE_SENT
  PAYMENT_RECEIVED
}

model Report {
  id        String    @id @default(uuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  summary   String?
  pdfUrl    String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, month, year])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

// Post creatives, stored in the database.
//
// Supabase Storage is the nicer home for these, but it needs a service-role key that was
// never configured, so uploads simply failed. The app already holds a Postgres connection,
// so the bytes live here instead and the feature works with no extra credentials. Images
// are downscaled client-side first, so a typical creative is a couple of hundred KB.
model MediaAsset {
  id        String   @id @default(uuid())
  contentId String?
  mimeType  String
  bytes     Bytes
  byteSize  Int
  createdAt DateTime @default(now())

  @@index([contentId])
}

model Settings {
  id           String   @id @default(uuid())
  agencyName   String   @default("OptiBrandz")
  logoUrl      String?
  address      String?
  phone        String?
  whatsapp     String?
  email        String?
  website      String?
  gstNumber    String?
  invoiceNotes String?
  bankDetails  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Somebody's own notes.
///
/// Not a second content to-do list. A ContentTask is what the agency owes a client and the
/// whole team can see it; this is what you owe yourself, and nobody sees it unless you say
/// so. Deliberately unattached to a Client for that reason.
model Note {
  id        String      @id @default(uuid())
  ownerId   String
  owner     User        @relation("NoteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  body      String      @default("")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  shares    NoteShare[]

  @@index([ownerId, updatedAt])
}

/// One person allowed to read one note.
///
/// A row per reader rather than a `sharedWithIds String[]` on Note: an array is rewritten
/// whole, so two shares issued from two devices race and one vanishes with no error — silent
/// data loss in the one feature whose value is trust. Rows also make double-sharing
/// impossible in the database rather than in a code check, and give the recipient's list an
/// indexed lookup and a date to show.
model NoteShare {
  id       String   @id @default(uuid())
  noteId   String
  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("NoteReader", fields: [userId], references: [id], onDelete: Cascade)
  sharedAt DateTime @default(now())

  @@unique([noteId, userId])
  @@index([userId, sharedAt])
}
