{
  "name": "Optibrandz CRM",
  "short_name": "Optibrandz",
  "description": "Leads, clients, invoices, content and campaigns for Optibrandz Marketing Agency.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#090909",
  "theme_color": "#090909",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add lead", "url": "/leads", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Invoices", "url": "/invoices", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Clients", "url": "/clients", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
